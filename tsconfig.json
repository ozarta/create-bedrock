{
  "compilerOptions": {
    "target": "ES2020",
    "module": "ES2020",
    "moduleResolution": "Bundler",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noEmitOnError": true,
    "skipLibCheck": false,
    "rootDir": "src",
    "outDir": "build/scripts",
    "lib": [
      "ES2020"
    ],
    "types": [],
    "newLine": "lf"
  },
  "include": [
    "src/**/*.ts"
  ]
}
