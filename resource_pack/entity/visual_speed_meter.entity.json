{
  "format_version": "1.10.0",
  "minecraft:client_entity": {
    "description": {
      "identifier": "bedrockworks:visual_speed_meter",
      "materials": {
        "default": "entity_alphatest"
      },
      "textures": {
        "default": "textures/blocks/speed_meter"
      },
      "geometry": {
        "default": "geometry.bedrockworks.speed_meter"
      },
      "animations": {
        "kinetic": "animation.bedrockworks.speed_meter"
      },
      "scripts": {
        "initialize": [
          "variable.angle = 0;"
        ],
        "pre_animation": [
          "variable.angle = math.mod(variable.angle + query.delta_time * query.property('bedrockworks:rpm') * 6, 360);"
        ],
        "animate": [
          "kinetic"
        ]
      },
      "render_controllers": [
        "controller.render.bedrockworks.mechanical"
      ]
    }
  }
}
