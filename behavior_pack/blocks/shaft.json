{
  "format_version": "1.21.100",
  "minecraft:block": {
    "description": {
      "identifier": "bedrockworks:shaft",
      "states": {
        "bedrockworks:axis": [
          "y",
          "x",
          "z"
        ]
      },
      "menu_category": {
        "category": "construction"
      }
    },
    "components": {
      "minecraft:geometry": "geometry.bedrockworks.shaft_base",
      "minecraft:material_instances": {
        "*": {
          "texture": "bedrockworks_shaft",
          "render_method": "opaque"
        }
      },
      "minecraft:destructible_by_mining": {
        "seconds_to_destroy": 1
      },
      "minecraft:destructible_by_explosion": {
        "explosion_resistance": 4
      },
      "minecraft:loot": "loot_tables/blocks/shaft.json",
      "minecraft:tick": {
        "interval_range": [
          20,
          20
        ],
        "looping": true
      },
      "bedrockworks:kinetic": {},
      "minecraft:movable": {
        "movement_type": "immovable"
      },
      "minecraft:item_visual": {
        "geometry": "geometry.bedrockworks.shaft",
        "material_instances": {
          "*": {
            "texture": "bedrockworks_shaft",
            "render_method": "opaque"
          }
        }
      }
    },
    "permutations": [
      {
        "condition": "q.block_state('bedrockworks:axis') == 'x'",
        "components": {
          "minecraft:transformation": {
            "rotation": [
              0,
              0,
              -90
            ]
          }
        }
      },
      {
        "condition": "q.block_state('bedrockworks:axis') == 'z'",
        "components": {
          "minecraft:transformation": {
            "rotation": [
              90,
              0,
              0
            ]
          }
        }
      }
    ]
  }
}
